PORT=4000

# Meta WhatsApp Cloud API (Free 1000 messages/month)
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_WA_ACCESS_TOKEN=your_meta_access_token_here
META_WA_BUSINESS_ACCOUNT_ID=your_waba_account_id_here
META_WA_API_VERSION=v21.0

# Shop Contact
BUSINESS_WHATSAPP=+91 93284 00954
OWNER_WHATSAPP=9876543210
SEND_OWNER_COPY=true

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/mokko
