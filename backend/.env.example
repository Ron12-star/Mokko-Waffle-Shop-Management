# ═══════════════════════════════════════════════════════════════
# 🧇 MOKKO SHOP MANAGEMENT — BACKEND CONFIGURATION
# ═══════════════════════════════════════════════════════════════

PORT=4000

# ─────────────────────────────────────────────────────────────
# 📱 WHATSAPP (TWILIO) CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Get free sandbox credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE

# Twilio WhatsApp sender (Sandbox default: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Your shop's contact number printed on customer PDF receipts
BUSINESS_WHATSAPP=+91 98765 43210

# 👑 Shop Owner / Manager WhatsApp Number
# Put your own WhatsApp number here to receive an owner copy of every order!
# Example: 9876543210 or +919876543210
OWNER_WHATSAPP=
SEND_OWNER_COPY=false

# ─────────────────────────────────────────────────────────────
# 🍃 MONGODB DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/mokko
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mokko?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mokko
